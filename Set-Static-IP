// Buka dan Edit file berikut
nano /etc/netplan/00-installer-config.yaml

// Rubah file menjadi seperti berikut ini
network:
  version: 2
  renderer: networkd
  ethernets:
    enp0s8:
      dhcp4: false
      addresses:
        - 192.168.56.10/24
      gateway4: 192.168.56.1
      nameservers:
          addresses: [8.8.8.8, 1.1.1.1]

// Untuk Ubuntu 22 or Above
network:
  version: 2
  renderer: networkd
  ethernets:
    enp0s8:
      dhcp4: false
      addresses:
        - 192.168.1.68/24
      routes:
        - to: default
          via: 192.168.1.1
#      gateway4: 192.168.1.1
      nameservers:
          addresses: [192.168.1.1]

// Apply perubahan
netplan apply
